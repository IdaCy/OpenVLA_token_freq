BootStrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export DEBIAN_FRONTEND=noninteractive

    # Set CUDA environment variables
    export CUDA_VERSION=12.1
    export CUDNN_VERSION=8
    export NCCL_VERSION=2
    export CUDA_HOME=/usr/local/cuda
    export PATH="$CUDA_HOME/bin:$PATH"
    export LD_LIBRARY_PATH="$CUDA_HOME/lib64:/usr/lib/x86_64-linux-gnu:$CUDA_HOME/extras/CUPTI/lib64:$LD_LIBRARY_PATH"

    # Set Conda paths
    export PATH="/opt/conda/bin:$PATH"
    export PYTHONPATH="/opt/conda/lib/python3.10/site-packages:$PYTHONPATH"

%post
    echo "Setting up the container environment..."

    # Prevent interactive prompts
    export DEBIAN_FRONTEND=noninteractive
    export TZ=Etc/UTC
    echo "Timezone set to $TZ"

    # Install dependencies with no interaction and cleanup
    apt-get update && apt-get install -y --no-install-recommends \
        python3.10 python3.10-venv python3.10-dev python3-pip \
        git wget unzip vim build-essential cmake libopenmpi-dev libomp-dev \
        libsndfile1-dev libblas-dev liblapack-dev \
        libgl1-mesa-glx ffmpeg curl software-properties-common \
        && rm -rf /var/lib/apt/lists/*

    # Ensure Python 3.10 is the default version
    update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1
    update-alternatives --config python

    # Verify Python and Pip versions
    which python
    python --version
    pip install --upgrade pip setuptools wheel

    # Install TensorFlow 2.15.0 (will work on Ubuntu 22.04)
    pip install --no-cache-dir tensorflow==2.15.0

    # Install PyTorch with CUDA support
    pip install --quiet --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118

    # Install additional Python dependencies silently
    pip install open_clip_torch captum shap lime einops
    pip install typing-extensions sqlalchemy

    # Clone and install OpenVLA non-interactively
    git clone --quiet https://github.com/openvla/openvla.git /opt/openvla
    cd /opt/openvla
    pip install --no-cache-dir .

    # Cleanup unnecessary files
    apt-get clean
    rm -rf ~/.cache/pip

    echo "Installation completed successfully."

%runscript
    exec python "$@"

%labels
    Author  Ida
    Version 1.0
    Description "Singularity container for OpenVLA model processing"