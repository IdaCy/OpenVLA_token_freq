#!/bin/bash
#PBS -N test_openvla_inference
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=04:00:00
#PBS -o logs/test_openvla_inference.out
#PBS -e logs/test_openvla_inference.err

cd $PBS_O_WORKDIR

echo "Starting OpenVLA inference..."

# Define the container path
CONTAINER_PATH="/rds/general/user/ifc24/home/OpenVLA-forget-tune/containers/ctopenvla.sif"

echo "Starting OpenVLA inference..."

# Execute inside Singularity with GPU support
singularity exec --nv --writable-tmpfs "$CONTAINER_PATH" \
    python /rds/general/user/ifc24/home/OpenVLA-forget-tune/scripts/test_openvla_inference.py

echo "Inference job completed."
