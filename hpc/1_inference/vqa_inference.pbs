#!/bin/bash
#PBS -N vqa_inference
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=08:00:00
#PBS -o logs/vqa_inference.out
#PBS -e logs/vqa_inference.err

cd $PBS_O_WORKDIR

echo "Starting OpenVLA inference on VQA 2..."

singularity exec --nv --writable-tmpfs containers/ctopenvla.sif \
    python scripts/stage1/vqa_inference.py

echo "Inference job completed."
