#!/bin/bash
#PBS -N coco_inference
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=08:00:00
#PBS -o logs/coco_inference.out
#PBS -e logs/coco_inference.err

cd $PBS_O_WORKDIR

echo "Starting OpenVLA inference on COCO..."

singularity exec --nv --writable-tmpfs containers/ctopenvla.sif \
    python scripts/stage1/coco_inference.py

echo "Inference job completed."
