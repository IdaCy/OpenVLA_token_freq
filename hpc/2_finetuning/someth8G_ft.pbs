#!/bin/bash
#PBS -N openvla_finetune
#PBS -l select=1:ncpus=32:ngpus=4:mem=128gb
#PBS -l walltime=24:00:00
#PBS -o logs/openvla_finetune.out
#PBS -e logs/openvla_finetune.err

cd $PBS_O_WORKDIR

echo "Starting OpenVLA fine-tuning on HPC..."

# Run fine-tuning inside Singularity container
singularity exec --nv --writable-tmpfs containers/ctopenvla.sif \
    torchrun --standalone --nnodes 1 --nproc-per-node 4 scripts/2_finetuning/someth8G_ft.py \
        --data_root_dir data \
        --dataset_name somethv2_rlds \
        --run_root_dir finetunes/somethv2_ft_logs \
        --adapter_tmp_dir finetunes/adapter_weights \
        --batch_size 16 \
        --max_steps 200000 \
        --learning_rate 5e-4 \
        --use_lora True

echo "Fine-tuning job completed."
